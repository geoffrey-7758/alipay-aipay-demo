# ============================================================
# 环境变量模板 —— 部署到 Render 时照这个填"环境变量"
# 注意：这个文件可以提交到 GitHub（不含真实密钥）
# 真实密钥只填在 Render 网页的环境变量里，不要写进这个文件！
# ============================================================

# 支付宝应用 ID
AIPAY_APP_ID=你的沙箱或生产APPID

# 应用私钥（PKCS#1 格式，非 Java 语言专用；填原始字符串，不加 PEM 头尾）
AIPAY_PRIVATE_PKCS_KEY=你的应用私钥

# 支付宝公钥（用于验签）
AIPAY_ALIPAY_PUBLIC_KEY=你的支付宝公钥

# 网关地址：沙箱默认，不填则自动用沙箱地址；上生产时填生产网关
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 端口：Render 会自动注入，本地留空即可
# PORT=3000
